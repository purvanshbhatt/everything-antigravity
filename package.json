{
  "name": "everything-antigravity",
  "version": "2.1.0",
  "description": "The one-stop performance pack for Google Antigravity and Gemini CLI: 79 skills and slash-command workflows, 23 subagents, glob-scoped rules, and verified hooks for guarding, memory, continuous learning and verify-before-done.",
  "main": "index.js",
  "bin": {
    "eag": "bin/eag.js",
    "everything-antigravity": "bin/eag.js"
  },
  "scripts": {
    "test": "node scripts/run-tests.js",
    "validate": "node bin/eag.js validate",
    "validate:strict": "node bin/eag.js validate --strict",
    "catalog": "node scripts/catalog.js",
    "doctor": "node bin/eag.js doctor"
  },
  "files": [
    "bin/eag.js",
    "scripts/hooks",
    "scripts/lib",
    "scripts/catalog.js",
    "skills",
    "agents",
    "rules",
    "assets",
    "hooks.json",
    "hooks/hooks.json",
    "plugin.json",
    "gemini-extension.json",
    "mcp-configs",
    "docs",
    "index.js",
    "install.sh",
    "install.ps1",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "keywords": [
    "antigravity",
    "google-antigravity",
    "gemini",
    "gemini-cli",
    "agentic-engineering",
    "agent-skills",
    "subagents",
    "hooks",
    "mcp",
    "tdd",
    "security"
  ],
  "author": "Purvansh Bhatt",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/purvanshbhatt/everything-antigravity.git"
  },
  "bugs": {
    "url": "https://github.com/purvanshbhatt/everything-antigravity/issues"
  },
  "homepage": "https://github.com/purvanshbhatt/everything-antigravity#readme"
}
