{
  "name": "everything-antigravity",
  "version": "1.0.0",
  "description": "The Agent Harness Operating System & Performance Optimization Suite for Google Antigravity, Gemini, and Agentic Engineering",
  "main": "index.js",
  "bin": {
    "eag": "./bin/eag.js",
    "everything-antigravity": "./bin/eag.js"
  },
  "scripts": {
    "test": "pytest tests/ && node -e \"const eag = require('./index.js'); console.log('Skills loaded:', eag.getSkills().length);\"",
    "verify": "python3 src/cli.py verify",
    "shield": "python3 src/cli.py shield",
    "status": "python3 src/cli.py status",
    "prepare": "chmod +x bin/eag.js bin/eag.sh"
  },
  "files": [
    "bin",
    "src/*.py",
    "skills",
    "agents",
    "commands",
    "rules",
    "mcp-configs",
    "plugins",
    ".antigravity",
    "index.js",
    "install.sh",
    "install.ps1",
    "LICENSE",
    "README.md",
    "pyproject.toml"
  ],
  "keywords": [
    "antigravity",
    "google-antigravity",
    "gemini",
    "agentic-engineering",
    "mcp",
    "subagents",
    "skills",
    "game-dev",
    "multimedia",
    "marketing",
    "security",
    "agent-harness"
  ],
  "author": "Purvansh Bhatt",
  "license": "MIT",
  "engines": {
    "node": ">=16.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/purvanshbhatt/everything-antigravity.git"
  },
  "bugs": {
    "url": "https://github.com/purvanshbhatt/everything-antigravity/issues"
  },
  "homepage": "https://github.com/purvanshbhatt/everything-antigravity#readme"
}
